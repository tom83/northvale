<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="northvale">
  <description>Drupal coding standards for custom code.</description>
  <file>web/modules/custom</file>
  <file>web/sites/default/settings.php</file>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
