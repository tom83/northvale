{
    "name": "portfolio/northvale-council",
    "description": "A white-label UK council website built on Drupal 11, published as static HTML with Tome.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "drupal/address": "^2.0",
        "drupal/core-composer-scaffold": "^11.2",
        "drupal/core-recommended": "^11.2",
        "drupal/editoria11y": "^3.0",
        "drupal/focal_point": "^2.1",
        "drupal/geofield": "^10.3",
        "drupal/layout_builder_browser": "^1.9",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/leaflet": "^10.4",
        "drupal/linkit": "^7.0",
        "drupal/metatag": "^2.2",
        "drupal/pathauto": "^1.16",
        "drupal/simple_sitemap": "^4.2",
        "drupal/smart_date": "^4.3",
        "drupal/tome": "^1",
        "drupal/webform": "^6.3",
        "drush/drush": "^13"
    },
    "require-dev": {
        "drupal/core-dev": "^11.2"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[project-root]/.gitattributes": false
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"],
            "recipes/{$name}": ["type:drupal-recipe"]
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "qa": ["@lint", "@analyse", "@test"]
    }
}
