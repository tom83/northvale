# phpstan-drupal and the deprecation rules are loaded automatically by
# phpstan/extension-installer (both come with drupal/core-dev).
parameters:
  level: 6
  paths:
    - web/modules/custom
  drupal:
    drupal_root: web
  ignoreErrors:
    # Deliberate: council_tome's normalizers extend Tome's to keep its ID
    # stripping rather than copy it. Tome is pinned in composer.lock; the
    # kernel tests cover the behaviour this relies on.
    -
      identifier: classExtendsInternalClass.classExtendsInternalClass
      path: web/modules/custom/council_core/modules/council_tome/src/Normalizer/*
