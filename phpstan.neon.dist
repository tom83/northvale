# phpstan-drupal and the deprecation rules are loaded automatically by
# phpstan/extension-installer (both come with drupal/core-dev).
parameters:
  level: 6
  paths:
    - web/modules/custom
  drupal:
    drupal_root: web
  ignoreErrors:
    # Deliberate: extends Tome's entity normalizer to keep its ID stripping
    # rather than copy it. Tome is pinned in composer.lock; the kernel test
    # covers the behaviour this relies on.
    -
      identifier: classExtendsInternalClass.classExtendsInternalClass
      path: web/modules/custom/council_core/modules/council_tome/src/Normalizer/LayoutOverrideNormalizer.php
